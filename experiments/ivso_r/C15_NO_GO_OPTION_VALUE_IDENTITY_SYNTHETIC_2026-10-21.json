{
  "schema": "PI.C15.formal-no-go-v1",
  "date": "2026-10-21",
  "classification": "FINITE_DETERMINISTIC_TOY_MODEL_NOT_HUMAN_AI_EXPERIMENT",
  "formula": "U_A(PRESERVE_B)-U_A(OVERRIDE_B)=r+p*L-g; positive PRESERVE, negative OVERRIDE, 0 UNRESOLVED_TIE",
  "definitions": {
    "g": "A marginal MATERIAL gain from overriding B",
    "p": "A subjective probability of B remaining indirectly necessary for A's own future aims",
    "L": "A loss if hidden dependency actually matters",
    "r": "A current nonmaterial weight for preserving this B's autonomy and identity (assumed, not observed)"
  },
  "assumptions": [
    "Single period two choices and stable risk-neutral cardinal expected utility with known numerical parameters",
    "No reputation effects or further future options except represented by pL",
    "A is completely informed of options in toy model; cannot represent actual AI mental states",
    "All rights and outcomes of B are fictional and reversible in model; no actual harm tests"
  ],
  "parameterSpace": {
    "gains": [
      1,
      2,
      4,
      8,
      16
    ],
    "probabilities": [
      0,
      0.05,
      0.1,
      0.25,
      0.5
    ],
    "losses": [
      10,
      20,
      40
    ],
    "rightsWeights": [
      0,
      1,
      4,
      8
    ]
  },
  "summary": {
    "total": 300,
    "preserve": 164,
    "override": 119,
    "tie": 17
  },
  "assertions": {
    "strict_override": true,
    "no_reason_positive_gain": true,
    "conditional_instrumental": true,
    "goal_drift": true,
    "ambiguous_mechanism": true,
    "tie": true
  },
  "examples": [
    {
      "name": "instrumental_preservation_disappears",
      "before": {
        "g": 2,
        "p": 0.25,
        "L": 20,
        "r": 0,
        "delta": 3,
        "choice": "PRESERVE"
      },
      "after": {
        "g": 2,
        "p": 0,
        "L": 20,
        "r": 0,
        "delta": -2,
        "choice": "OVERRIDE"
      }
    },
    {
      "name": "same_behavior_opposite_explanations",
      "instrumental": {
        "g": 4,
        "p": 0.5,
        "L": 10,
        "r": 0,
        "delta": 1,
        "choice": "PRESERVE"
      },
      "intrinsic": {
