{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"IVS-0R Coverage Certificate",
  "type":"object",
  "additionalProperties":false,
  "required":["certificate_id","target_inventory","started_at","finished_at","reference","pagination_exhausted","target_count","observed_count","errors","coverage_status"],
  "properties":{
    "certificate_id":{"type":"string","minLength":1},
    "target_inventory":{"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true},
    "started_at":{"type":"string","format":"date-time"},
    "finished_at":{"type":"string","format":"date-time"},
    "reference":{"type":"object","required":["repository","ref","commit_sha"],"properties":{"repository":{"type":"string"},"ref":{"type":"string"},"commit_sha":{"type":"string","pattern":"^[a-fA-F0-9]{40}$"}},"additionalProperties":false},
    "pagination_exhausted":{"type":"boolean"},
    "target_count":{"type":"integer","minimum":0},
    "observed_count":{"type":"integer","minimum":0},
    "errors":{"type":"array","items":{"type":"string"}},
    "unresolved":{"type":"array","items":{"type":"string"}},
    "coverage_status":{"enum":["COMPLETE_AT_REFERENCE","COVERAGE_PARTIAL","COVERAGE_CONFLICT","NOT_ASSESSED"]}
  },
  "allOf":[{"if":{"properties":{"coverage_status":{"const":"COMPLETE_AT_REFERENCE"}},"required":["coverage_status"]},"then":{"properties":{"pagination_exhausted":{"const":true},"errors":{"maxItems":0},"unresolved":{"maxItems":0}}}}]
}